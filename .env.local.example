# Copy this file to .env.local for local development.
# On Vercel, add each of these under Project Settings -> Environment Variables instead.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe: Developers -> API keys (use sk_test_/pk_test_ until you go live)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe: Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Your live domain once connected (used to build Stripe redirect URLs).
# For local dev, leave this as http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
